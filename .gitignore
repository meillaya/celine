# Kavita Docker - Git Ignore

# Configuration and data directories (contain user data)
config/
data/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# Railway local files (if using Railway CLI)
.railway/

# Docker volumes (if stored locally)
volumes/
*.volume/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp