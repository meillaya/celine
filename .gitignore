# Celine - Git Ignore

# Runtime data and state. These live on the media drive and are never committed.
/config/
/config.backup/
/data/
/state/
/backups/
/build/

# Local tooling caches
/.cache/
/.gopath/
/.devenv/
/.direnv/
/.runtime/
/result
/result-*

# Secrets: only the SOPS-encrypted store is tracked.
/secrets/*.plain.*
/secrets/*.dec.*
/secrets/*.tmp
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
